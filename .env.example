# Copy this file to .env and fill in the real values.

# Discord
# The webhook is still supported as a simple fallback monitor.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/example
DISCORD_USER_ID=000000000000000000

# Fill these in to enable slash commands and gateway bot alert posting.
ENABLE_DISCORD_BOT=false
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=000000000000000000
DISCORD_ALERT_CHANNEL_ID=000000000000000000
DISCORD_ADMIN_USER_IDS=000000000000000000

# Nitrado FTP
FTP_HOST=example.ftp.nitrado.net
FTP_PORT=21
FTP_USERNAME=your_ftp_username
FTP_PASSWORD=your_ftp_password
FTP_PATH=/arksa/ShooterGame/Saved/Logs/ShooterGame.log
FTP_USE_TLS=false

# ARK RCON
RCON_HOST=example.rcon.nitrado.net
RCON_PORT=27020
RCON_PASSWORD=your_rcon_password
RCON_TIMEOUT_SECONDS=8

# Bot behavior
SERVER_NAME=Guppy's Collectibles Ragnarok
POLL_SECONDS=60
TIMEZONE=America/New_York
STATE_FILE=.ark-log-bot-state.json
SEND_EXISTING_ON_FIRST_RUN=false
INCLUDE_SAVES=false
MAX_SEEN_EVENTS=2000
